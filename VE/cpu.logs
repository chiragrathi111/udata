* sudo nano /usr/local/bin/idempiere-health.sh

below code paste it

#!/bin/bash

LOG_DIR="/var/log/idempiere-health"
LOG_FILE="$LOG_DIR/health.log"
DATE=$(date '+%Y-%m-%d %H:%M:%S')

mkdir -p $LOG_DIR

echo "===============================" >> $LOG_FILE
echo "Time: $DATE" >> $LOG_FILE

# CPU
echo "CPU Load:" >> $LOG_FILE
uptime >> $LOG_FILE

# Memory
echo "Memory:" >> $LOG_FILE
free -h >> $LOG_FILE

# Disk
echo "Disk:" >> $LOG_FILE
df -h / >> $LOG_FILE

# Java Process
echo "Java Process:" >> $LOG_FILE
ps -eo pid,comm,%cpu,%mem --sort=-%mem | grep java | head -n 5 >> $LOG_FILE

# ================= PostgreSQL Process =================
echo "PostgreSQL Process (Top 5 by CPU):" >> $LOG_FILE
ps -eo pid,comm,%cpu,%mem --sort=-%cpu | grep postgres | head -n 5 >> $LOG_FILE

# ================= PostgreSQL Active Queries =================
echo "PostgreSQL Active Queries:" >> $LOG_FILE
psql -U adempiere -d idempiere -c "
select pid,
       state,
       wait_event_type,
       wait_event,
       now() - query_start as running_time
from pg_stat_activity
where state <> 'idle'
order by running_time desc
limit 5;
" >> $LOG_FILE 2>/dev/null

# OOM killer
echo "OOM Kill Check:" >> $LOG_FILE
dmesg -T | grep -i "killed process" | tail -n 3 >> $LOG_FILE

echo "" >> $LOG_FILE


* sudo chmod +x /usr/local/bin/idempiere-health.sh

* sudo crontab -e

*    */10 * * * * /usr/local/bin/idempiere-health.sh

