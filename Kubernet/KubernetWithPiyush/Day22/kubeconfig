apiVersion: v1
kind: Config

clusters:
- cluster:
  name: development
- cluster:
  name: test

users:
- name: developer
- name: experimenter

contexts:
- context:
    cluster: development # This context is for development cluster (not manatory, If required, you can specify cluster in context)
    user: developer # This context is for developer user (not manatory, If required, you can specify user in context)
  name: dev-frontend
- context:
  name: dev-storage
- context:
  name: exp-test

  # Set user configuration
#   k config set-credentials myuser \
# > --client-key=../Day21/myuser.key \
# > --client-certificate=../Day21/myuser.csr

# If you want run one line instaed of multiline, you can use below command:
# k config set-credentials myuser --client-key=../Day21/myuser.key --client-certificate=../Day21/myuser.csr
# output:
# User "myuser" set.

# myuser is the name of the user, and the
#  --client-key and --client-certificate flags specify the paths to the user's client key and
#  certificate files, respectively. This command adds the user "myuser" to the kubeconfig file with 
# the specified credentials.

# If you want to set-context the user configuration, you can use below command:
# kubectl config set-context myuser --cluster=dev-cluster-worker2 --user=myuser
# output:
# Context "myuser" created.

# myuser is the name of the context, and the
# --cluster and --user flags specify the cluster and user to associate with this context, respectively.

# Get-context command:
# kubectl config get-contexts
# output:
# CURRENT   NAME               CLUSTER               AUTHINFO             NAMESPACE
# *         kind-dev-cluster   kind-dev-cluster      kind-dev-cluster   
#           myuser             dev-cluster-worker2   myuser    

# If want to switch to a different context, you can use below command:
# kubectl config use-context myuser
# output:
# Switched to context "myuser".