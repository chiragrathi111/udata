	<queryString language="SQL">
		<![CDATA[select pi.labeluuid as label, mp.name AS productName,ml.m_inout_id,pi.quantity AS quantity from adempiere.pi_productlabel pi
join adempiere.m_inoutline ml on ml.m_inoutline_id = pi.m_inoutline_id 
join adempiere.m_product mp on mp.m_product_id = pi.m_product_Id 
where ml.ad_client_id =  $P{AD_CLIENT_ID}  and ml.m_inout_id = $P{RECORD_ID} ;]]>
	</queryString>
