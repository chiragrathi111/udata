# SIMPLE SOLUTION: VPC Peering for Cross-Region Communication\n# This replaces the complex TGW setup with simple, reliable VPC peering\n# Cost: FREE (no hourly charges) vs TGW: $108/month\n\n# VPC Peering: VPC1 (us-east-1) ↔ VPC2 (us-west-2)\nresource \"aws_vpc_peering_connection\" \"vpc1_to_vpc2\" {\n  vpc_id        = aws_vpc.vpc1.id\n  peer_vpc_id   = aws_vpc.vpc2.id\n  peer_region   = var.region[\"region_vpc2\"]\n  auto_accept   = false\n\n  tags = {\n    Name = \"VPC1-to-VPC2-Peering\"\n    Purpose = \"Cross-region communication\"\n  }\n}\n\n# Accept the peering connection in us-west-2\nresource \"aws_vpc_peering_connection_accepter\" \"vpc1_to_vpc2_accepter\" {\n  provider                  = aws.vpc2\n  vpc_peering_connection_id = aws_vpc_peering_connection.vpc1_to_vpc2.id\n  auto_accept               = true\n\n  tags = {\n    Name = \"VPC1-to-VPC2-Accepter\"\n  }\n}\n\n# VPC Peering: VPC1 (us-east-1) ↔ VPC3 (eu-west-1)\nresource \"aws_vpc_peering_connection\" \"vpc1_to_vpc3\" {\n  vpc_id        = aws_vpc.vpc1.id\n  peer_vpc_id   = aws_vpc.vpc3.id\n  peer_region   = var.region[\"region_vpc3\"]\n  auto_accept   = false\n\n  tags = {\n    Name = \"VPC1-to-VPC3-Peering\"\n    Purpose = \"Cross-region communication\"\n  }\n}\n\n# Accept the peering connection in eu-west-1\nresource \"aws_vpc_peering_connection_accepter\" \"vpc1_to_vpc3_accepter\" {\n  provider                  = aws.vpc3\n  vpc_peering_connection_id = aws_vpc_peering_connection.vpc1_to_vpc3.id\n  auto_accept               = true\n\n  tags = {\n    Name = \"VPC1-to-VPC3-Accepter\"\n  }\n}\n\n# VPC Peering: VPC2 (us-west-2) ↔ VPC3 (eu-west-1)\nresource \"aws_vpc_peering_connection\" \"vpc2_to_vpc3\" {\n  provider      = aws.vpc2\n  vpc_id        = aws_vpc.vpc2.id\n  peer_vpc_id   = aws_vpc.vpc3.id\n  peer_region   = var.region[\"region_vpc3\"]\n  auto_accept   = false\n\n  tags = {\n    Name = \"VPC2-to-VPC3-Peering\"\n    Purpose = \"Cross-region communication\"\n  }\n}\n\n# Accept the peering connection in eu-west-1\nresource \"aws_vpc_peering_connection_accepter\" \"vpc2_to_vpc3_accepter\" {\n  provider                  = aws.vpc3\n  vpc_peering_connection_id = aws_vpc_peering_connection.vpc2_to_vpc3.id\n  auto_accept               = true\n\n  tags = {\n    Name = \"VPC2-to-VPC3-Accepter\"\n  }\n}\n\n# Routes for VPC1 to reach other VPCs\nresource \"aws_route\" \"vpc1_to_vpc2_route\" {\n  route_table_id            = aws_route_table.rt_vpc1.id\n  destination_cidr_block    = var.cidr[\"cidr_vpc2\"]  # 13.0.0.0/16\n  vpc_peering_connection_id = aws_vpc_peering_connection.vpc1_to_vpc2.id\n\n  depends_on = [aws_vpc_peering_connection_accepter.vpc1_to_vpc2_accepter]\n}\n\nresource \"aws_route\" \"vpc1_to_vpc3_route\" {\n  route_table_id            = aws_route_table.rt_vpc1.id\n  destination_cidr_block    = var.cidr[\"cidr_vpc3\"]  # 14.0.0.0/16\n  vpc_peering_connection_id = aws_vpc_peering_connection.vpc1_to_vpc3.id\n\n  depends_on = [aws_vpc_peering_connection_accepter.vpc1_to_vpc3_accepter]\n}\n\n# Routes for VPC2 to reach other VPCs\nresource \"aws_route\" \"vpc2_to_vpc1_route\" {\n  provider                  = aws.vpc2\n  route_table_id            = aws_route_table.rt_vpc2.id\n  destination_cidr_block    = var.cidr[\"cidr_vpc1\"]  # 12.0.0.0/16\n  vpc_peering_connection_id = aws_vpc_peering_connection.vpc1_to_vpc2.id\n\n  depends_on = [aws_vpc_peering_connection_accepter.vpc1_to_vpc2_accepter]\n}\n\nresource \"aws_route\" \"vpc2_to_vpc3_route\" {\n  provider                  = aws.vpc2\n  route_table_id            = aws_route_table.rt_vpc2.id\n  destination_cidr_block    = var.cidr[\"cidr_vpc3\"]  # 14.0.0.0/16\n  vpc_peering_connection_id = aws_vpc_peering_connection.vpc2_to_vpc3.id\n\n  depends_on = [aws_vpc_peering_connection_accepter.vpc2_to_vpc3_accepter]\n}\n\n# Routes for VPC3 to reach other VPCs\nresource \"aws_route\" \"vpc3_to_vpc1_route\" {\n  provider                  = aws.vpc3\n  route_table_id            = aws_route_table.rt_vpc3.id\n  destination_cidr_block    = var.cidr[\"cidr_vpc1\"]  # 12.0.0.0/16\n  vpc_peering_connection_id = aws_vpc_peering_connection.vpc1_to_vpc3.id\n\n  depends_on = [aws_vpc_peering_connection_accepter.vpc1_to_vpc3_accepter]\n}\n\nresource \"aws_route\" \"vpc3_to_vpc2_route\" {\n  provider                  = aws.vpc3\n  route_table_id            = aws_route_table.rt_vpc3.id\n  destination_cidr_block    = var.cidr[\"cidr_vpc2\"]  # 13.0.0.0/16\n  vpc_peering_connection_id = aws_vpc_peering_connection.vpc2_to_vpc3.id\n\n  depends_on = [aws_vpc_peering_connection_accepter.vpc2_to_vpc3_accepter]\n}