#If i want getting ami_id not hard code it is possible follow below steps:-
data "aws_ami" "ubuntu" {
    most_recent = true
    owners = ["491085410969"]  #copy this owner id means AWS ID

    filter {
        name = "name"
        values = ["amazon/ubuntu/images/hvm-ssd-gp3/ubuntu-noble-24.04-amd64-server-*"] #copy image name this is also show on ami,please remove last no of id and press *
    }
    filter {
        name = "root-device-type"
        values = ["ebs"]
    }
    filter {
        name = "virtualization-type"
        values = ["hvm"]
    }
}
#how can get id
output "ami_id" {
    value = data.aws_ami.id
}


