# ── Terraform State ────────────────────────────────────────────────────────────
# State files contain sensitive data (IPs, IDs, secrets) — never commit these
*.tfstate
*.tfstate.backup

# State lock file (created during apply to prevent concurrent runs)
.terraform.lock.hcl

# Terraform working directory — contains downloaded provider binaries (~100MB+)
.terraform/

# Plan output files — can contain sensitive resource details
*.tfplan
*.plan

# Crash logs generated by Terraform on unexpected failures
crash.log
crash.*.log

# ── Variable Files ─────────────────────────────────────────────────────────────
# tfvars files can contain secrets (instance IDs, passwords, keys)
# Use TF_VAR_* environment variables instead (see README)
terraform.tfvars
*.tfvars
*.tfvars.json

# Keep the example file so others know what variables are needed
!terraform.tfvars.example

# ── Lambda Build Artifacts ─────────────────────────────────────────────────────
# ZIP files are auto-generated by Terraform's archive_file data source
# No need to commit — regenerated on every terraform plan/apply
lambda_function/*.zip

# ── AWS & Secrets ──────────────────────────────────────────────────────────────
# Never commit AWS credentials or any .env files
.env
.env.*
*.pem
*.key
credentials

# ── OS & Editor Noise ─────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo
